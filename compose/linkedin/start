#!/bin/bash
# compose/start

set -o errexit
set -o pipefail
set -o nounset

MODE="${MODE:-daemon}"

# Virtual display (always needed — Playwright launches headed mode)
rm -f /tmp/.X99-lock
Xvfb :99 -screen 0 1920x1080x24 &
sleep 1
export DISPLAY=:99

# VNC remote access (local use; always on in manual mode — the whole
# point of a manual session is interacting with the browser over VNC).
if [ "${ENABLE_VNC:-false}" = "true" ] || [ "$MODE" = "manual" ]; then
    x11vnc -display :99 -forever -shared -nopw &
    websockify --web /opt/noVNC 6080 localhost:5900 &
fi

# Manual browser mode: Xvfb + VNC + manual_browser, no daemon. Arguments
# are forwarded verbatim, e.g. --url https://www.linkedin.com/login
# --save-state /app/data/storage_state.json.
if [ "$MODE" = "manual" ]; then
    exec python manage.py manual_browser "$@"
fi

# Run the daemon (migrate + onboard + task queue).
# Forward any arguments, e.g. --onboard <file>.
exec python manage.py rundaemon "$@"
